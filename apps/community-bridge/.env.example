# Identidad canónica MyFenrir (Supabase yqevglppbhuoxxfsfnih). La publishable
# key es pública por diseño; los datos de comunidad viven en Neon (worker secret).
VITE_SUPABASE_URL=https://yqevglppbhuoxxfsfnih.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t8xng5GIhOmAtT4Nsf7Zgg_TO36FTTE

# Canonical origin for og:url / canonical / sitemap. Must be set per environment
# in the Cloudflare Pages build vars — otherwise getSiteUrl() falls back to
# http://localhost:5173 and leaks into generated <head> markup.
#   production → https://communities.myfenrir.com
#   quality    → https://quality.communities.myfenrir.com
#   local      → http://localhost:5173
VITE_SITE_URL=https://communities.myfenrir.com

# ── Community Authentik OIDC (Community Bridge login boundary) ─────────────
# Server-side only (worker secrets — never reach the browser). When unset,
# /login shows an explicit "not configured" state instead of falling back to
# Supabase or the MyFenrir SSO handoff. One Authentik organization for all
# Community Bridge Gates; do not reuse the FriskyDev/MyFenrir client.
AUTHENTIK_ISSUER=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
# Quality redirect target registered on the Authentik OIDC application:
AUTHENTIK_REDIRECT_URI=https://quality.communities.myfenrir.com/auth/callback
AUTHENTIK_SESSION_SECRET=

# ── Community Authentik OIDC (server-only, worker secrets) ────────────────
# The Community Bridge login boundary: ONE Authentik organization, independent
# of MyFenrir/FriskyDev. Set these ONLY on community-bridge-quality (via
# `wrangler secret put`). They are read by src/lib/authentik.server.ts and never
# shipped to the browser. Until all five are set, /login shows a clearly-labelled
# "Community sign-in is not configured yet" state and no Authentik flow starts.
#   AUTHENTIK_ISSUER=https://<authentik-host>/application/o/<slug>/
#   AUTHENTIK_CLIENT_ID=<oidc client id>
#   AUTHENTIK_CLIENT_SECRET=<oidc client secret>
#   AUTHENTIK_REDIRECT_URI=https://quality.communities.myfenrir.com/auth/callback
#   AUTHENTIK_SESSION_SECRET=<random 32+ bytes>
