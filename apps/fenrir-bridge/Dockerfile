FROM node:22-alpine AS build

WORKDIR /app

COPY package.json ./
RUN npm install

COPY . .

ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ARG VITE_AUTH_REDIRECT_ORIGIN
ARG VITE_AUTH_REDIRECT_PATH=/auth/callback
ARG VITE_FENRIR_MANAGED_URL=https://www.myfenrir.com/main
ARG VITE_CUSTOM_DOMAIN_URL
ARG VITE_DEFAULT_SERVICE_ORG="Frisky Dev Workspace"
ARG VITE_DEFAULT_SERVICE_SUBDOMAIN=vip.myfenrir.com

ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY
ENV VITE_AUTH_REDIRECT_ORIGIN=$VITE_AUTH_REDIRECT_ORIGIN
ENV VITE_AUTH_REDIRECT_PATH=$VITE_AUTH_REDIRECT_PATH
ENV VITE_FENRIR_MANAGED_URL=$VITE_FENRIR_MANAGED_URL
ENV VITE_CUSTOM_DOMAIN_URL=$VITE_CUSTOM_DOMAIN_URL
ENV VITE_DEFAULT_SERVICE_ORG=$VITE_DEFAULT_SERVICE_ORG
ENV VITE_DEFAULT_SERVICE_SUBDOMAIN=$VITE_DEFAULT_SERVICE_SUBDOMAIN

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
