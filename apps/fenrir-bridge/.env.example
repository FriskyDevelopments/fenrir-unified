# Alpha must use the raw Supabase project URL until auth.friskydev.com is
# verified as a Supabase custom domain or made DNS-only. A proxied CNAME from
# auth.friskydev.com to <project-ref>.supabase.co returns Cloudflare 1014.
# Branded auth can come back after the custom domain is fixed.
# Free/raw Supabase auth host. Use auth.friskydev.com only after Supabase
# custom auth domain is paid for and verified.
VITE_SUPABASE_URL=https://yqevglppbhuoxxfsfnih.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_AUTH_REDIRECT_ORIGIN=https://www.myfenrir.com
VITE_AUTH_REDIRECT_PATH=/auth/callback
VITE_FENRIR_MANAGED_URL=https://www.myfenrir.com/main
# Optional: set only after a real customer-owned domain is verified.
VITE_CUSTOM_DOMAIN_URL=
VITE_DEFAULT_SERVICE_ORG="Frisky Dev Workspace"
VITE_DEFAULT_SERVICE_SUBDOMAIN=vip.myfenrir.com
# Set to disabled on frontend-only previews where /api/* is intentionally blocked.
VITE_VERCEL_API_MODE=

# Server-side Supabase JWT verification for Fenrir Community Gate.
# These can point at the same Supabase Auth project as the client env above,
# but Neon stores Community Gate profiles, invites, sessions, and audit logs.
# Match VITE_SUPABASE_URL. For the free setup, use the raw Supabase project URL.
SUPABASE_URL=https://yqevglppbhuoxxfsfnih.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Operator readiness flags. Set each to true only after the provider is enabled
# in Supabase Auth and its provider console has the production URLs below.
FENRIR_GOOGLE_OAUTH_CONFIGURED=false
FENRIR_MICROSOFT_OAUTH_CONFIGURED=false
FENRIR_APPLE_OAUTH_CONFIGURED=false

# Production OAuth wiring:
# Supabase Auth URL Configuration:
#   Site URL: https://myfenrir.com
#   Additional Redirect URLs:
#     https://myfenrir.com/auth/callback
#     https://www.myfenrir.com/auth/callback
# Google OAuth client:
#   Authorized JavaScript origins:
#     https://myfenrir.com
#     https://www.myfenrir.com
#   Authorized redirect URI:
#     https://yqevglppbhuoxxfsfnih.supabase.co/auth/v1/callback
# Apple Sign in with Apple:
#   Services ID web domain:
#     myfenrir.com
#   Return URLs:
#     https://yqevglppbhuoxxfsfnih.supabase.co/auth/v1/callback
#     https://myfenrir.com/auth/callback
#     https://www.myfenrir.com/auth/callback
# Microsoft publisher verification:
#   https://myfenrir.com/.well-known/microsoft-identity-association.json
FENRIR_CANONICAL_ORIGIN=https://www.myfenrir.com
FENRIR_BRIDGE_TARGET=bridge.myfenrir.com
FENRIR_ALLOWED_ORIGINS=https://www.myfenrir.com,https://myfenrir.com

# Fenrir Community Gate data plane (separate Neon database, no auth.users FK).
# `/api/readiness` reports this as the Neon Community Gate database status.
NEON_DATABASE_URL=

# Legacy magic-link prototype settings. Keep until the old /api/community-auth routes are removed.
FENRIR_COMMUNITY_AUTH_SECRET=
FENRIR_COMMUNITY_AUTH_DEV_RETURN_LINK=false
PUBLIC_SITE_URL=https://myfenrir.com
FENRIR_BRAND_ADMIN_MODE=internal_only
FENRIR_BRAND_ADMIN_ALLOWLIST=
