# Social/email login is Supabase Auth (client-side signInWithOAuth) plus the
# direct per-provider OAuth below. There is no third-party login broker.
# Telegram/WebAuthn remain.
VITE_AUTH_REDIRECT_ORIGIN=https://www.myfenrir.com
VITE_AUTH_REDIRECT_PATH=/auth/callback
VITE_DIRECT_AUTH_ORIGIN=https://auth.myfenrir.com
VITE_FENRIR_MANAGED_URL=https://www.myfenrir.com/main
# Telegram login widget: el bot canónico es @Myfenrir_bot. El token vive en
# 1Password (op://Personal/MYFENRIR BOT TOKEN) → Pages secret TELEGRAM_BOT_TOKEN.
VITE_FENRIR_TELEGRAM_BOT_USERNAME=Myfenrir_bot
# Exact dashboard destination used by the "Open Community Bridge" actions.
# The separate Community Bridge app (apps/community-bridge, Neon-based) lives
# at communities.myfenrir.com; gate.myfenrir.com keeps the Workers (stars, /tg).
VITE_COMMUNITY_BRIDGE_DASHBOARD_URL=https://communities.myfenrir.com/dashboard
# Optional: set only after a real customer-owned domain is verified.
VITE_CUSTOM_DOMAIN_URL=
VITE_DEFAULT_SERVICE_ORG="Frisky Dev Workspace"
VITE_DEFAULT_SERVICE_SUBDOMAIN=vip.myfenrir.com
# Set to disabled on frontend-only previews where /api/* is intentionally blocked.
VITE_VERCEL_API_MODE=

# REQUIRED. HMAC secret used to sign the Fenrir session cookie and OAuth
# state tokens. If this is missing or blank in production, session minting
# throws and returns HTTP 500.
# Use a long random value, e.g.: openssl rand -base64 48
SESSION_SECRET=

# OPTIONAL. Dedicated HMAC secret for the ALTCHA human-verification gate.
# When absent, the verification code derives its signing key from SESSION_SECRET
# with domain separation. If NEITHER is set in the deployed environment, the
# /api/verification/challenge endpoint returns 503 "automatic_challenge_unavailable"
# and the login gate falls back to the slider puzzle.
#   openssl rand -base64 48
HUMAN_VERIFICATION_SECRET=
# Legacy compatibility only; HUMAN_VERIFICATION_SECRET takes precedence.
ALTCHA_HMAC_SECRET=

# Supabase is retained ONLY as an optional profile data store (service role)
# for the direct-OAuth and Telegram paths. It is no longer a login broker.
# Leave blank to disable profile upserts entirely.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Direct OAuth provider credentials. Fenrir owns the callback and mints its own
# session cookie; Supabase can still be used for profile storage via service role.
# The SAME credentials drive both the operator gate (auth.myfenrir.com) and the
# Community Bridge (www.myfenrir.com) — only the redirect URI differs, so each
# provider console needs BOTH callback URLs registered. See docs/COMMUNITY_OAUTH_RUNBOOK.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Apple: this is the Services ID (e.g. com.friskydev.myfenrir.web), NOT the App ID.
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contents of the AuthKey_<KEY_ID>.p8 file, newlines escaped as \n.
APPLE_PRIVATE_KEY=

# Operator readiness flags. Set these only after each provider is configured.
FENRIR_GOOGLE_OAUTH_CONFIGURED=false
FENRIR_MICROSOFT_OAUTH_CONFIGURED=false
FENRIR_APPLE_OAUTH_CONFIGURED=false

# Production OAuth wiring:
# Google OAuth client:
#   Authorized JavaScript origins:
#     https://myfenrir.com
#     https://www.myfenrir.com
#     https://auth.myfenrir.com
#   Authorized redirect URI:
#     https://auth.myfenrir.com/api/auth/callback/google
# Microsoft OAuth app:
#   Redirect URI:
#     https://auth.myfenrir.com/api/auth/callback/microsoft
# Apple Sign in with Apple:
#   Services ID web domain:
#     auth.myfenrir.com
#   Return URLs:
#     https://auth.myfenrir.com/api/auth/callback/apple
# Microsoft publisher verification:
#   https://auth.myfenrir.com/.well-known/microsoft-identity-association.json
#
# Community Bridge OAuth wiring (Neon session, cookie fenrir_community_session).
# The bridge derives its callback from PUBLIC_SITE_URL, so PUBLIC_SITE_URL MUST be
# set in production — otherwise it falls back to the request origin and an apex-vs-www
# mismatch makes every provider reject the redirect_uri.
#   Google  redirect URI: https://www.myfenrir.com/api/community-auth/oauth/callback/google
#   Microsoft redirect URI: https://www.myfenrir.com/api/community-auth/oauth/callback/microsoft
#   Apple   return URL:   https://www.myfenrir.com/api/community-auth/oauth/callback/apple
FENRIR_CANONICAL_ORIGIN=https://www.myfenrir.com
PUBLIC_SITE_URL=https://www.myfenrir.com
PUBLIC_AUTH_URL=https://auth.myfenrir.com
FENRIR_BRIDGE_TARGET=bridge.myfenrir.com
FENRIR_ALLOWED_ORIGINS=https://www.myfenrir.com,https://myfenrir.com,https://auth.myfenrir.com

# Fenrir Community Gate data plane (separate Neon database, no auth.users FK).
# `/api/readiness` reports this as the Neon Community Gate database status.
NEON_DATABASE_URL=

# Legacy magic-link prototype settings. Keep until the old /api/community-auth routes are removed.
FENRIR_COMMUNITY_AUTH_SECRET=
FENRIR_COMMUNITY_AUTH_DEV_RETURN_LINK=false
FENRIR_BRAND_ADMIN_MODE=internal_only
FENRIR_BRAND_ADMIN_ALLOWLIST=

# ─── Fenrir Gate — Telegram Mini App verification (Cloudflare Turnstile) ──────
# Enables the Telegram join-request gate. When a user requests to join a group
# with the bot as admin, the bot DMs them a Mini App with Turnstile. Once they
# pass, the bot calls approveChatJoinRequest.
# Get these from Cloudflare Dashboard → Turnstile → Add Site.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# URL where the Mini App is served. Defaults to myfenrir.com/gate/app (served
# by the worker itself). Override if hosting elsewhere.
FENRIR_GATE_MINI_APP_URL=https://www.myfenrir.com/gate/app
